{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "MONGODB_URI": {
      "description": "MongoDB connection string",
      "required": true
    },
    "JWT_SECRET": {
      "description": "JWT signing secret key",
      "required": true
    },
    "NODE_ENV": {
      "description": "Environment (production/development)",
      "value": "production",
      "required": true
    },
    "SEED_PASSWORD": {
      "description": "Password for seed API endpoint",
      "value": "dev-seed-key",
      "required": false
    }
  },
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": true
  },
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
