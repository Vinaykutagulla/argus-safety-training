# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/argus-db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-secret-key-here-minimum-32-characters-recommended

# Environment
NODE_ENV=development

# Seed Password (for API protection)
SEED_PASSWORD=dev-seed-key

# Optional: API Base URL for production
NEXT_PUBLIC_API_URL=http://localhost:3000
